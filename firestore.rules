rules_version = '2';

// Kojin ToDo 用の Firestore セキュリティルール
// ログインした本人だけが、自分の uid の下（users/{uid}/...）を読み書きできる。
// Firebase コンソールの「Firestore Database > ルール」にこの内容を貼り付けて「公開」する。
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
